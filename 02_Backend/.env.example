# ==============================================================================
# Enterprise Accounts & Business Management System (EABMS)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   copy .env.example .env

# Target Fund Account: NGL (NexGen Holdings), EWF (Employee Welfare Fund), CPF (Corporate Provident Fund)
ABMS_FUND=NGL

# Django Environment: 'development' or 'production'
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL recommended; fallback: sqlite3)
DB_ENGINE=postgresql
DB_NAME=eabms_ngl
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Display currency symbol (default: Rs)
# ABMS_CURRENCY_SYMBOL=Rs
